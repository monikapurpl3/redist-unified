<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  Declares Windows 10 and 11 support. Without it, Windows tells a program it
  runs on Windows 8 (6.2), and reports Windows' own files as version 6.2 too.
  Embedded in this crate's tests and examples by build.rs; the client exe
  needs the same compatibility section in its own manifest.
-->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 and Windows 11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}"/>
    </application>
  </compatibility>
</assembly>
